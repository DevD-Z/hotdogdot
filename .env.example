# Server-side deployment tooling only. Never expose this value to Vite/client code.
RENDER_API_KEY=
RENDER_SERVICE_ID=

# Public Discord Application ID used by the native desktop integration.
DISCORD_CLIENT_ID=

# Lavalink deployment settings.
LAVALINK_SERVER_PASSWORD=change-me

# Optional on macOS/CI. The Team can also be selected manually in Xcode.
APPLE_DEVELOPMENT_TEAM=
